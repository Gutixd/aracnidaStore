# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Mercado Pago (Checkout Pro)
MP_ACCESS_TOKEN=
NEXT_PUBLIC_MP_PUBLIC_KEY=
# Secreto de firma del webhook (panel de MP > Webhooks). Opcional pero recomendado.
MP_WEBHOOK_SECRET=

# Correo (Resend) — comprobante de compra al cliente
RESEND_API_KEY=
# Remitente. Requiere dominio verificado en Resend.
# Sin dominio verificado usa: AracnidaStore <onboarding@resend.dev>
RESEND_FROM=

# Google Calendar — reserva automática de la hora de retiro
# OAuth con la cuenta personal del dueño (no cuenta de servicio: Workspace
# suele bloquear la creación de sus claves). Ver guía de configuración para
# obtener estos 3 valores. Opcional: sin ellos, el sitio funciona igual y
# solo se omite este paso.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REFRESH_TOKEN=
# "primary" usa el calendario principal del dueño.
GOOGLE_CALENDAR_ID=primary

# Instagram — publicación automática desde el panel
# Cuenta Business/Creator de Instagram vinculada a una página de Facebook,
# vía Meta Graph API. Ver guía de configuración para obtener estos 2 valores.
# Opcional: sin ellos, se pueden programar publicaciones igual, pero el cron
# diario no las va a subir.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# Claude (Anthropic) — genera el copy automáticamente al subir varias
# imágenes de una en /admin/instagram. Se saca en console.anthropic.com.
# Opcional: sin ella, esa sección no aparece y hay que escribir el copy a mano.
ANTHROPIC_API_KEY=

# Google Gemini — chat de atención al cliente en el sitio (burbuja abajo a
# la derecha). Se saca gratis en aistudio.google.com/apikey. Opcional: sin
# ella, la burbuja de chat simplemente no aparece.
GEMINI_API_KEY=

# Notificaciones push del panel de admin (aviso de pedido nuevo en el
# celular, aunque el panel esté cerrado). Se generan UNA vez con:
#   npx web-push generate-vapid-keys
# La pública va también al navegador (por eso NEXT_PUBLIC_), la privada
# nunca sale del servidor. Opcional: sin ellas, el botón de notificaciones
# en /admin/settings no aparece.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contacto@aracnidastore.com

# Protege /api/cron/publish-instagram de llamadas externas. Vercel agrega
# este valor solo como header cuando existe — no hace falta tocarlo si
# corre como Vercel Cron.
CRON_SECRET=

# Admin
ADMIN_SECRET=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_STORE_NAME=AracnidaStore
